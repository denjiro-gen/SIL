            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"BS Artificial Intelligence\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/courses", "host": ["{{baseUrl}}"], "path": ["api", "courses"] }
          }
        },
        {
          "name": "GET Courses as STUDENT (403 Test)",
          "event": [
            {
              "listen": "test",
              "script": {
