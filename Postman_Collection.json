{
  "info": {
    "name": "SIL - Spring Boot Security API",
    "_postman_id": "sil-spring-boot-security-api",
    "description": "Complete REST API with JWT Security, RBAC & Global Exception Handling.\n\n## Test Accounts\n- ADMIN: username=admin, password=admin123\n- STUDENT: username=alex_mercer, password=password123\n\n## How to Use\n1. Run 'POST Login (ADMIN)' - token is auto-saved to {{adminToken}}\n2. Run 'POST Login (STUDENT)' - token is auto-saved to {{studentToken}}\n3. Use any other request (tokens are set automatically)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "adminToken", "value": "", "type": "string" },
    { "key": "studentToken", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "AUTH",
      "item": [
        {
          "name": "POST Login (ADMIN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('adminToken', json.token);",
                  "    pm.test('Login successful - token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "} else {",
                  "    pm.test('Login failed', () => pm.expect(pm.response.code).to.eq(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST Login (STUDENT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('studentToken', json.token);",
                  "    pm.test('Login successful - token saved', () => pm.expect(json.token).to.be.a('string'));",
                  "} else {",
                  "    pm.test('Login failed', () => pm.expect(pm.response.code).to.eq(200));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"alex_mercer\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "POST Login (Invalid - 401 Test)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 Unauthorized', () => pm.expect(pm.response.code).to.eq(401));",
                  "var json = pm.response.json();",
                  "pm.test('Has error format', () => {",
                  "    pm.expect(json).to.have.property('timestamp');",
                  "    pm.expect(json).to.have.property('status');",
                  "    pm.expect(json).to.have.property('error');",
                  "    pm.expect(json).to.have.property('message');",
                  "    pm.expect(json).to.have.property('path');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrongpassword\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
